# Local Ollama (default). For Ollama Cloud use https://ollama.com and set the key.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# Comma-separated models to compare
MODELS=qwen3:1.7b,qwen2.5:1.5b,granite3.3:2b,smollm2:1.7b
REPEATS=3

# Assumed price used only to ESTIMATE cost from token counts (runs are free)
COST_PER_1M_INPUT_USD=0.10
COST_PER_1M_OUTPUT_USD=0.40

# Optional: true/false to force thinking on/off for models that support it (e.g. qwen3)
THINK=
